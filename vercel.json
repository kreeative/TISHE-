{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "includeFiles": "src/data/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/#/admin",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "/#/admin",
      "permanent": false
    }
  ]
}
